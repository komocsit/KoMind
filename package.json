{
  "name": "komind",
  "displayName": "KoMind",
  "publisher": "komind",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/host/extension.js",
  "icon": "media/komind-logo.png",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "koMind",
          "title": "KoMind",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "koMind": [
        {
          "type": "webview",
          "id": "koMind.chat",
          "name": "Agent Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "koMind.setApiKey",
        "title": "KoMind: Set API Key"
      },
      {
        "command": "koMind.newSession",
        "title": "KoMind: New Session"
      },
      {
        "command": "koMind.resetPermissions",
        "title": "KoMind: Reset Always-Allow Permissions"
      }
    ],
    "configuration": {
      "title": "KoMind",
      "properties": {
        "koMind.baseUrl": {
          "type": "string",
          "default": "https://api.justwoker.icu"
        },
        "koMind.model": {
          "type": "string",
          "default": "gpt-5.6-sol"
        },
        "koMind.maxTokens": {
          "type": "number",
          "default": 4096
        },
        "koMind.effort": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "default": "medium",
          "description": "Default reasoning effort sent to the API"
        },
        "koMind.autoApproveEdits": {
          "type": "boolean",
          "default": true
        },
        "koMind.autoApproveTerminal": {
          "type": "boolean",
          "default": false
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "test:unit": "vitest run",
    "test:integration": "npm run compile && node test/integration/run.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "mocha": "^12.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "dompurify": "^3.4.15",
    "marked": "^18.0.12",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  }
}
